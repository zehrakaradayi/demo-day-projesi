# Supabase projesinden alınacak (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxxxxx"
SUPABASE_SERVICE_ROLE_KEY="xxxxxxxx" # sadece server-side kullanılır, asla client'a sızdırılmaz

# Prisma - Supabase (Project Settings > Database > Connection string)
# DATABASE_URL: connection pooler (pgbouncer, port 6543) - uygulama runtime'ı için
# DIRECT_URL: direct connection (port 5432) - migration'lar için
DATABASE_URL="postgresql://postgres.rifvldhprusaakgxtudp:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.rifvldhprusaakgxtudp:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Google Gemini API (aistudio.google.com) — chat içi AI özellikleri için:
# Conversation Starter, Spin the Question, Conversation Rescue, AI Meetup Planner.
# Ücretsiz katman yeterli, kredi kartı istemez.
GEMINI_API_KEY="xxxxxxxx"
# Call site'larda hardcode ETMEYİN, buradan değiştirin. "gemini-flash-latest" DEĞİL:
# ücretsiz katmanda her model adının kotası (günde 20 istek) ayrı sayılıyor ve
# "-latest" alias'ı ekip genelinde paylaşılıp hızlı tükeniyor; "lite" varyantı aynı
# işi görüyor ve kendi ayrı kotasına sahip.
GEMINI_MODEL="gemini-flash-lite-latest"
