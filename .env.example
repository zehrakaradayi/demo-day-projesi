# Supabase projesinden alınacak (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxxxxx"
SUPABASE_SERVICE_ROLE_KEY="xxxxxxxx" # sadece server-side kullanılır, asla client'a sızdırılmaz

# Prisma - Supabase (Project Settings > Database > Connection string)
# DATABASE_URL: connection pooler (pgbouncer, port 6543) - uygulama runtime'ı için
# DIRECT_URL: direct connection (port 5432) - migration'lar için
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
