// SkillSwap — Prisma schema (MVP scope + Branch 3 "Social & Community")
// Kaynak: SkillSwap Master Ürün Brifi V2, bölüm 20 "Veri Modeli" + MVP kapsamı (bölüm 19).
//
// Notlar:
// - User.id, Supabase Auth'taki auth.users.id (uuid) ile birebir aynıdır ve kayıt
//   sırasında uygulama tarafından atanır (bu yüzden @default yok).
// - Skill DNA/Passport, Missions, Skill Chain, Skill Credits gibi diğer V1/V2
//   tabloları hâlâ bilinçli olarak bu şemada YOK — ilgili branch'ler ihtiyaç
//   duyduğunda ekleyecek. Community/SkillStory/Meetup, Branch 3 kapsamında eklendi.
// - Culture Swap için ayrı bir model YOK: User.country/languages/network + UserSkill
//   üzerinden filtrelenmiş bir görünüm olarak uygulanıyor (gerçek ihtiyaç çıkarsa
//   ileride model eklenir).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Bu Supabase projesi başka bir uygulamayla paylaşılıyor (public şemasında
  // ilişkisiz tablolar var) — SkillSwap tabloları izole bir şemada tutuluyor,
  // böylece db push asla public şemaya dokunmaz.
  schemas = ["skillswap"]
  // Bağlantı URL'leri prisma.config.ts içinde tanımlı (Prisma 7).
}

// ---------- Enums ----------

enum Network {
  TURKIYE
  GLOBAL

  @@schema("skillswap")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY

  @@schema("skillswap")
}

enum GenderPreference {
  MALE
  FEMALE
  EVERYONE

  @@schema("skillswap")
}

enum SkillMode {
  TEACH
  LEARN

  @@schema("skillswap")
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT

  @@schema("skillswap")
}

enum TeachingStyle {
  THEORY
  PRACTICE
  PROJECT
  CONVERSATION
  COWORKING

  @@schema("skillswap")
}

enum LearningPurpose {
  SCHOOL
  CAREER
  HOBBY
  DAILY_LIFE

  @@schema("skillswap")
}

enum SocialEnergy {
  LOW
  MEDIUM
  HIGH

  @@schema("skillswap")
}

enum MeetingPreference {
  ONLINE
  IN_PERSON
  BOTH

  @@schema("skillswap")
}

enum PlanningStyle {
  PLANNED
  SPONTANEOUS

  @@schema("skillswap")
}

enum Pace {
  CALM
  ACTIVE

  @@schema("skillswap")
}

enum GroupSizePreference {
  SMALL_GROUP
  LARGE_GROUP
  EITHER

  @@schema("skillswap")
}

enum MatchModePreference {
  SIMILAR
  COMPLEMENTARY
  OPPOSITE
  NO_PREFERENCE

  @@schema("skillswap")
}

enum YearStatus {
  PREP
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
  GRADUATE

  @@schema("skillswap")
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED

  @@schema("skillswap")
}

enum GuideType {
  STUDENT
  ALUMNI

  @@schema("skillswap")
}

enum SessionStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED

  @@schema("skillswap")
}

enum MatchStatus {
  SUGGESTED
  LIKED
  PASSED
  MUTUAL

  @@schema("skillswap")
}

enum MessageType {
  TEXT
  VOICE

  @@schema("skillswap")
}

enum ContributionSource {
  GUIDE_SESSION
  SKILL_SESSION
  OTHER

  @@schema("skillswap")
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED

  @@schema("skillswap")
}

// ---------- Kullanıcı & Lifestyle Interview (bölüm 3) ----------

model User {
  id               String            @id @db.Uuid
  email            String            @unique
  name             String
  avatarUrl        String?
  ageRange         String? // ör. "18-24" — basit bucket, MVP için yeterli
  gender           Gender?
  genderPreference GenderPreference?
  city             String?
  country          String?
  network          Network           @default(TURKIYE)
  languages        String[]          @default([])
  phoneHidden      String? // varsayılan gizli iletişim bilgisi (bölüm 16)
  isMinor          Boolean           @default(false) // reşit olmayan kullanıcılar için sıkı kurallar
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  lifestyleProfile   LifestyleProfile?
  educations         UserEducation[]
  guideProfile       GuideProfile?
  userSkills         UserSkill[]
  userCourseTopics   UserCourseTopic[]
  contributionLedger ContributionLedger[]

  guideSessionsAsGuide       GuideSession[] @relation("GuideSessionsAsGuide")
  guideSessionsAsParticipant GuideSession[] @relation("GuideSessionsAsParticipant")

  skillSessionsAsTeacher SkillSession[] @relation("SkillSessionsAsTeacher")
  skillSessionsAsLearner SkillSession[] @relation("SkillSessionsAsLearner")

  matchesAsA Match[] @relation("MatchesAsA")
  matchesAsB Match[] @relation("MatchesAsB")

  conversations ConversationParticipant[]
  messages      Message[]

  blocksMade     Block[] @relation("BlocksMade")
  blocksReceived Block[] @relation("BlocksReceived")

  reportsMade     Report[] @relation("ReportsMade")
  reportsReceived Report[] @relation("ReportsReceived")

  communitiesCreated   Community[]           @relation("CommunitiesCreated")
  communityMemberships CommunityMembership[]
  skillStories         SkillStory[]
  meetupsCreated       Meetup[]              @relation("MeetupsCreated")
  meetupParticipations MeetupParticipant[]

  @@index([city, country])
  @@index([network])
  @@schema("skillswap")
}

model LifestyleProfile {
  id                    String               @id @default(uuid())
  userId                String               @unique @db.Uuid
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialEnergy          SocialEnergy?
  meetingPreference     MeetingPreference?
  planningStyle         PlanningStyle?
  pace                  Pace?
  groupSizePreference   GroupSizePreference?
  matchModePreference   MatchModePreference?
  budgetLevel           Int? // 1 (düşük) - 3 (yüksek)
  transportPreference   String?
  venuePreference       String?
  isNewInCity           Boolean              @default(false)
  firstMeetupBoundaries String? // ilk buluşmada istemedikleri / güvenlik sınırları
  careerGoals           String?
  academicStrengths     String[]             @default([])
  hobbies               String[]             @default([])
  interests             String[]             @default([])
  availability          Json? // haftalık müsaitlik, ör. { "mon": ["evening"], ... }
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@schema("skillswap")
}

// ---------- Skill Sistemi (bölüm 4) ----------

model Skill {
  id            String         @id @default(uuid())
  name          String         @unique
  category      String
  userSkills    UserSkill[]
  skillSessions SkillSession[]
  skillStories  SkillStory[]

  @@schema("skillswap")
}

model UserSkill {
  id              String           @id @default(uuid())
  userId          String           @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  mode            SkillMode
  level           SkillLevel
  teachingStyle   TeachingStyle?
  learningPurpose LearningPurpose?
  experienceYears Int?
  createdAt       DateTime         @default(now())

  @@unique([userId, skillId, mode])
  @@schema("skillswap")
}

// ---------- Dersler (bölüm 4, "Okul Dersleri") ----------

model Course {
  id       String        @id @default(uuid())
  name     String        @unique // ör. "Matematik"
  category String?
  topics   CourseTopic[]

  @@schema("skillswap")
}

model CourseTopic {
  id            String            @id @default(uuid())
  courseId      String
  course        Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name          String // ör. "Türev"
  level         String? // ör. "Lise", "Üniversite"
  userTopics    UserCourseTopic[]
  skillSessions SkillSession[]

  @@unique([courseId, name, level])
  @@schema("skillswap")
}

model UserCourseTopic {
  id        String      @id @default(uuid())
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String
  topic     CourseTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  mode      SkillMode
  level     SkillLevel
  createdAt DateTime    @default(now())

  @@unique([userId, topicId, mode])
  @@schema("skillswap")
}

// ---------- Okul & Bölüm Ağı (bölüm 5) ----------

model School {
  id           String          @id @default(uuid())
  name         String
  country      String
  city         String?
  type         String? // "university" | "high_school"
  verified     Boolean         @default(false)
  departments  Department[]
  educations   UserEducation[]
  communities  Community[]
  skillStories SkillStory[]

  @@unique([name, city, country])
  @@schema("skillswap")
}

model Department {
  id           String          @id @default(uuid())
  schoolId     String
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String
  faculty      String?
  category     String?
  educations   UserEducation[]
  communities  Community[]
  skillStories SkillStory[]

  @@unique([schoolId, name])
  @@schema("skillswap")
}

model UserEducation {
  id                 String             @id @default(uuid())
  userId             String             @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId           String
  school             School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  departmentId       String?
  department         Department?        @relation(fields: [departmentId], references: [id])
  yearStatus         YearStatus?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([userId, schoolId, departmentId])
  @@schema("skillswap")
}

// Bölüm rehberliği (Guide) — bölüm 5 "Bölüm rehberliği" + "Guide Profile"
model GuideProfile {
  id               String    @id @default(uuid())
  userId           String    @unique @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics           String[]  @default([]) // ör. "Bölümü Tanıma", "Hazırlık Süreci"
  sessionDurations Int[]     @default([30, 60]) // dakika seçenekleri
  guideType        GuideType
  isActive         Boolean   @default(true)
  availability     Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@schema("skillswap")
}

model GuideSession {
  id              String        @id @default(uuid())
  guideId         String        @db.Uuid
  guide           User          @relation("GuideSessionsAsGuide", fields: [guideId], references: [id], onDelete: Cascade)
  participantId   String        @db.Uuid
  participant     User          @relation("GuideSessionsAsParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  topic           String
  durationMinutes Int
  scheduledAt     DateTime?
  status          SessionStatus @default(REQUESTED)
  rating          Int? // 1-5
  feedback        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  contributionEntries ContributionLedger[]

  @@index([guideId])
  @@index([participantId])
  @@schema("skillswap")
}

// ---------- Genel Skill / Ders Session'ları (bölüm 4, 12) ----------

model SkillSession {
  id              String        @id @default(uuid())
  teacherId       String        @db.Uuid
  teacher         User          @relation("SkillSessionsAsTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  learnerId       String        @db.Uuid
  learner         User          @relation("SkillSessionsAsLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  skillId         String?
  skill           Skill?        @relation(fields: [skillId], references: [id])
  courseTopicId   String?
  courseTopic     CourseTopic?  @relation(fields: [courseTopicId], references: [id])
  scheduledAt     DateTime?
  durationMinutes Int?
  status          SessionStatus @default(REQUESTED)
  rating          Int?
  feedback        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  contributionEntries ContributionLedger[]

  @@index([teacherId])
  @@index([learnerId])
  @@schema("skillswap")
}

// ---------- AI Match Engine (bölüm 6) ----------

model Match {
  id        String               @id @default(uuid())
  userAId   String               @db.Uuid
  userA     User                 @relation("MatchesAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String               @db.Uuid
  userB     User                 @relation("MatchesAsB", fields: [userBId], references: [id], onDelete: Cascade)
  score     Float
  reasons   Json // "Why matched" — faktör kırılımı, ör. [{ "factor": "skill_reciprocity", "weight": 0.3 }]
  mode      MatchModePreference?
  status    MatchStatus          @default(SUGGESTED)
  createdAt DateTime             @default(now())

  @@unique([userAId, userBId])
  @@index([userBId])
  @@schema("skillswap")
}

// ---------- Chat (bölüm 8) ----------

model Conversation {
  id             String                    @id @default(uuid())
  createdAt      DateTime                  @default(now())
  communityId    String?                   @unique // sadece Community grup sohbetleri için set edilir
  community      Community?                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  participants   ConversationParticipant[]
  messages       Message[]
  meetups        Meetup[]
  askedQuestions AskedQuestion[]

  @@schema("skillswap")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime? // okunmamış mesaj sayısı / read-receipt temeli

  @@unique([conversationId, userId])
  @@schema("skillswap")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @db.Uuid
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type           MessageType  @default(TEXT)
  content        String
  createdAt      DateTime     @default(now())

  reports Report[]

  @@index([conversationId, createdAt])
  @@schema("skillswap")
}

// ---------- Katkı Ekonomisi (bölüm 5 "Rehberlik Session'ları ile puan kazanma", bölüm 12) ----------

model ContributionLedger {
  id             String             @id @default(uuid())
  userId         String             @db.Uuid
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  points         Int
  source         ContributionSource
  guideSessionId String?
  guideSession   GuideSession?      @relation(fields: [guideSessionId], references: [id])
  skillSessionId String?
  skillSession   SkillSession?      @relation(fields: [skillSessionId], references: [id])
  createdAt      DateTime           @default(now())

  @@index([userId])
  @@schema("skillswap")
}

// ---------- Güvenlik ve Gizlilik (bölüm 16) ----------

model Block {
  id        String   @id @default(uuid())
  blockerId String   @db.Uuid
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @db.Uuid
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@schema("skillswap")
}

model Report {
  id          String              @id @default(uuid())
  contentType ReportedContentType @default(USER)

  reporterId String @db.Uuid
  reporter   User   @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)

  // contentType=USER olduğunda dolu; diğer türlerde biliniyorsa yine set edilebilir (ör. mesaj göndereni)
  reportedId String? @db.Uuid
  reported   User?   @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)

  reportedMessageId String?
  reportedMessage   Message? @relation(fields: [reportedMessageId], references: [id])

  reportedMeetupId String?
  reportedMeetup   Meetup? @relation(fields: [reportedMeetupId], references: [id])

  reportedCommunityId String?
  reportedCommunity   Community? @relation(fields: [reportedCommunityId], references: [id])

  reason    String
  details   String?
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())

  @@index([reportedId])
  @@index([contentType])
  @@schema("skillswap")
}

// ---------- Social & Community — Branch 3 kapsamı ----------

enum CommunityRole {
  OWNER
  MODERATOR
  MEMBER

  @@schema("skillswap")
}

enum MeetupStatus {
  DRAFT // AI alternatifleri üretildi, henüz seçilmedi/paylaşılmadı
  PROPOSED // bir sohbete paylaşıldı, onay bekliyor
  CONFIRMED
  CANCELLED

  @@schema("skillswap")
}

enum MeetupTier {
  BUDGET
  BALANCED
  PREMIUM

  @@schema("skillswap")
}

enum MeetupParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED

  @@schema("skillswap")
}

enum AskedQuestionSource {
  STARTER // Conversation Starter önerisi
  SPIN // Spin the Question
  RESCUE // Conversation Rescue

  @@schema("skillswap")
}

enum ReportedContentType {
  USER
  MESSAGE
  MEETUP
  COMMUNITY
  SKILL_STORY

  @@schema("skillswap")
}

// 3-8 kişilik küçük gruplar (bölüm 10) — okul/bölüm community'leri School/Department'ı reuse eder (bölüm 11)
model Community {
  id           String      @id @default(uuid())
  name         String
  description  String?
  category     String?
  city         String?
  country      String?
  isPublic     Boolean     @default(true)
  rules        String?
  schoolId     String?
  school       School?     @relation(fields: [schoolId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdById  String      @db.Uuid
  createdBy    User        @relation("CommunitiesCreated", fields: [createdById], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  members      CommunityMembership[]
  conversation Conversation?
  reports      Report[]

  @@index([schoolId, departmentId])
  @@index([city, country])
  @@schema("skillswap")
}

model CommunityMembership {
  id          String        @id @default(uuid())
  communityId String
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  @@unique([communityId, userId])
  @@index([userId])
  @@schema("skillswap")
}

// 15-30 saniyelik "Bunu sana öğretebilirim" videoları (bölüm 14)
model SkillStory {
  id              String      @id @default(uuid())
  userId          String      @db.Uuid
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoUrl        String // Supabase Storage
  caption         String?
  durationSeconds Int
  skillId         String?
  skill           Skill?      @relation(fields: [skillId], references: [id])
  schoolId        String?
  school          School?     @relation(fields: [schoolId], references: [id])
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  viewCount       Int         @default(0)
  createdAt       DateTime    @default(now())

  @@index([skillId])
  @@index([schoolId, departmentId])
  @@schema("skillswap")
}

// AI Meetup Planner (bölüm 9)
model Meetup {
  id                       String        @id @default(uuid())
  createdById              String        @db.Uuid
  createdBy                User          @relation("MeetupsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  conversationId           String?
  conversation             Conversation? @relation(fields: [conversationId], references: [id])
  city                     String
  peopleCount              Int
  budgetLevel              Int? // 1 (düşük) - 3 (yüksek), LifestyleProfile.budgetLevel ile aynı ölçek
  date                     DateTime?
  timeRangeStart           String? // "19:00"
  timeRangeEnd             String? // "23:30"
  vibe                     String?
  transportPreference      String?
  foodOrActivityPreference String?
  status                   MeetupStatus  @default(DRAFT)
  chosenAlternativeId      String?       @unique
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  alternatives      MeetupAlternative[] @relation("MeetupAlternatives")
  chosenAlternative MeetupAlternative?  @relation("ChosenAlternative", fields: [chosenAlternativeId], references: [id])
  participants      MeetupParticipant[]
  reports           Report[]

  @@index([createdById])
  @@schema("skillswap")
}

model MeetupAlternative {
  id                      String     @id @default(uuid())
  meetupId                String
  meetup                  Meetup     @relation("MeetupAlternatives", fields: [meetupId], references: [id], onDelete: Cascade)
  tier                    MeetupTier
  totalBudgetEstimate     Float?
  perPersonBudgetEstimate Float?
  aiRawResponse           Json? // ham AI yanıtı, audit/debug için
  createdAt               DateTime   @default(now())

  stops     MeetupStop[]
  chosenFor Meetup?      @relation("ChosenAlternative")

  @@index([meetupId])
  @@schema("skillswap")
}

model MeetupStop {
  id                           String            @id @default(uuid())
  alternativeId                String
  alternative                  MeetupAlternative @relation(fields: [alternativeId], references: [id], onDelete: Cascade)
  order                        Int
  startTime                    String // "19:30"
  locationName                 String // "Karaköy"
  activityType                 String // "workshop" | "dinner" | "rooftop" | ...
  transportMinutesFromPrevious Int?
  notes                        String?

  @@index([alternativeId, order])
  @@schema("skillswap")
}

model MeetupParticipant {
  id       String                  @id @default(uuid())
  meetupId String
  meetup   Meetup                  @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  userId   String                  @db.Uuid
  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status   MeetupParticipantStatus @default(INVITED)

  @@unique([meetupId, userId])
  @@schema("skillswap")
}

// Spin the Question / Conversation Rescue — "aynı soruyu tekrar sorma" durumu
model AskedQuestion {
  id             String              @id @default(uuid())
  conversationId String
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  question       String
  source         AskedQuestionSource
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@schema("skillswap")
}
